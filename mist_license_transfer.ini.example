[mist]
base_url = https://api.eu.mist.com/api/v1
# A single API token for a user with access to the source org and every
# destination org listed below.
api_token = YOUR_API_TOKEN

[source]
org_id = YOUR_SOURCE_ORG_ID

[destinations]
# One or more candidate destination org IDs, comma-separated (or one per
# indented line). If more than one is listed, you'll be prompted at runtime
# to pick which one licenses should be moved to/from.
org_ids = YOUR_DEST_ORG_ID_1, YOUR_DEST_ORG_ID_2

# Optional - only needed if you're behind a TLS-inspecting proxy (e.g.
# Zscaler). Delete this whole section, or leave the values blank, to use
# normal system defaults (certifi's CA store, and the HTTP_PROXY /
# HTTPS_PROXY / NO_PROXY environment variables if set).
[network]
# Path to a PEM file with your proxy's root CA certificate (or a bundle
# that includes it), so TLS verification succeeds against its inspected
# connections. Most Zscaler deployments can export this from the client
# app, or your IT team will have it.
ca_bundle =
# Only set this to false if you have no way to obtain the proxy's CA
# certificate. This disables TLS certificate verification entirely and is
# not recommended.
verify_ssl = true
# Explicit proxy overrides - usually unnecessary, since requests already
# honors HTTP_PROXY / HTTPS_PROXY / NO_PROXY from the environment.
http_proxy =
https_proxy =
